--- !u!114 &1741774680
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1741774678}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b792d6d7d37d461fe85ff1b224a35b23, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  interactionCanvas: {fileID: 804355087676721984}
  fadeDuration: 0.3
  maxUses: -1
  dialogues:
  - text: "\xA1Te he estado esperando! La distorsi\xF3n afect\xF3 los equipos del
      laboratorio y bloque\xF3 el sistema el\xE9ctrico del s\xF3tano."
    sprite: {fileID: 21300000, guid: 021f5584a264de9fcbaa6fd4ec6fbb73, type: 3}
  - text: "Repara las cajas el\xE9ctricas que encontrar\xE1s en el camino para restablecer
      la energ\xEDa."
    sprite: {fileID: 21300000, guid: 021f5584a264de9fcbaa6fd4ec6fbb73, type: 3}
  - text: "Si lo logras, obtendr\xE1s un recompensa que te ayudar\xE1 a restaurar
      el equilibrio del campus. "
    sprite: {fileID: 21300000, guid: 021f5584a264de9fcbaa6fd4ec6fbb73, type: 3}
  - text: "Entendido\u2026 reparar\xE9 esas cajas para traer de vuelta la luz al
      laboratorio antes de que Phobos se adue\xF1e del lugar."
    sprite: {fileID: 21300000, guid: afb6e6a90c9ce9e09a20c4bff1f11b80, type: 3}
